{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "AI.md", ".agents/rules.md", ".agents/memory/HOT.md"],
  "permissions": [
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
    { "action": "edit", "resource": "**/.env", "effect": "deny" }
  ],
  "compaction": {
    "auto": true,
    "keep": { "tokens": 8000 },
    "buffer": 10000
  },
  "mcp": {
    "servers": {
      "odoo_matia": {
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "uvx",
          "odoo-mcp@1.3.0"
        ],
        "environment": {
          "ODOO_URL": "{env:MATIA_ODOO_URL}",
          "ODOO_DB": "{env:MATIA_ODOO_DB}",
          "ODOO_USERNAME": "{env:MATIA_ODOO_USERNAME}",
          "ODOO_PASSWORD": "{env:MATIA_ODOO_PASSWORD}",
          "ODOO_TRANSPORT": "{env:MATIA_ODOO_TRANSPORT}"
        }
      },
      "odoo_staging": {
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "uvx",
          "odoo-mcp@1.3.0"
        ],
        "environment": {
          "ODOO_URL": "{env:MATIA_ODOO_STAGING_URL}",
          "ODOO_DB": "{env:MATIA_ODOO_STAGING_DB}",
          "ODOO_USERNAME": "{env:MATIA_ODOO_STAGING_USERNAME}",
          "ODOO_PASSWORD": "{env:MATIA_ODOO_STAGING_PASSWORD}",
          "ODOO_TRANSPORT": "{env:MATIA_ODOO_STAGING_TRANSPORT}",
          "ODOO_MCP_ENABLE_WRITES": "{env:MATIA_ODOO_MCP_ENABLE_WRITES_STAGING}"
        }
      }
    }
  }
}
