{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "AI.md"],
  "mcp": {
    "odoo_matia": {
      "type": "local",
      "command": [
        "cmd",
        "/c",
        "uvx",
        "odoo-mcp@0.6.0"
      ],
      "environment": {
        "ODOO_URL": "{env:ODOO_URL}",
        "ODOO_DB": "{env:ODOO_DB}",
        "ODOO_USERNAME": "{env:ODOO_USERNAME}",
        "ODOO_PASSWORD": "{env:ODOO_PASSWORD}",
        "ODOO_TRANSPORT": "{env:ODOO_TRANSPORT}"
      }
    }
  }
}
