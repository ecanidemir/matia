<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="MatiaProcurementPlan.Dashboard">
        <div class="o_matia_procurement_plan">

            <!-- 1. Header Bar (capacity template: icon + title area + icon actions) -->
            <div class="mpp-header">
                <div class="mpp-title-area">
                    <i class="fa fa-industry"></i>
                    <div>
                        <h2>Production Plan</h2>
                        <p>Admin only. RFQs/MOs are created as drafts; nothing is confirmed automatically.</p>
                    </div>
                </div>
                <div class="mpp-actions">
                    <button class="btn btn-outline-light btn-sm mpp-btn-reload" title="Refresh Data">
                        <i class="fa fa-refresh mr-1"></i> Refresh
                    </button>
                    <button class="btn btn-success btn-sm mpp-btn-excel" title="Export suppliers to Excel">
                        <i class="fa fa-file-excel-o mr-1"></i> Excel (suppliers)
                    </button>
                    <button class="btn btn-success btn-sm mpp-btn-excel-tree" title="Export tree to Excel">
                        <i class="fa fa-file-excel-o mr-1"></i> Excel (tree)
                    </button>
                </div>
            </div>

            <!-- 2. Step navigation -->
            <ul class="nav nav-tabs mpp-nav-tabs">
                <li class="nav-item">
                    <a href="#" class="nav-link mpp-nav-tab active" data-tab="1">
                        <i class="fa fa-sitemap mr-1"></i>1. Plan
                    </a>
                </li>
                <li class="nav-item">
                    <a href="#" class="nav-link mpp-nav-tab" data-tab="2">
                        <i class="fa fa-truck mr-1"></i>2. Suppliers &amp; Production
                    </a>
                </li>
            </ul>

            <!-- TAB 1: single-page plan (quantities + tree + cost) -->
            <div class="mpp-pane" data-pane="1">
                <div class="msp-table-card mt-2">
                    <div class="msp-table-search">
                        <div class="search-input-box">
                            <i class="fa fa-search"></i>
                            <input type="text" class="mpp-tree-search" placeholder="Search part code or name (all BOMs)..."/>
                        </div>
                        <div class="table-legend">
                            <span><span class="dot-ok"></span> OK = covered by stock</span>
                            <span><span class="dot-need"></span> Red = net shortage after stock netting</span>
                            <span class="legend-note" style="color: #0369a1; background: #f0f9ff; padding: 2px 8px; border-radius: 4px; border: 1px solid #bae6fd; font-size: 0.72rem; font-weight: 500;">
                                <i class="fa fa-info-circle mr-1"></i> Reserved &amp; NCR quantities are excluded from netting
                            </span>
                            <span class="text-muted" style="font-size:0.7rem;"><i class="fa fa-sort mr-1"></i> Click column headers to sort</span>
                            <span class="text-muted" style="font-size:0.7rem;"><i class="fa fa-database mr-1"></i> TR + US Unreserved: on-hand minus reserved per warehouse</span>
                        </div>
                        <div class="msp-tool-buttons">
                            <button class="btn btn-primary btn-sm mpp-btn-recalc" title="Rebuild the tree from the Needed numbers">
                                <i class="fa fa-calculator mr-1"></i> Recalculate
                            </button>
                            <button class="btn btn-outline-primary btn-sm msp-btn-expand-all" title="Expand all sub-assembly BOMs">
                                <i class="fa fa-plus-square-o mr-1"></i> Expand All BOMs
                            </button>
                            <button class="btn btn-secondary btn-sm msp-btn-collapse-all" title="Collapse all sub-assembly BOMs">
                                <i class="fa fa-minus-square-o mr-1"></i> Collapse All BOMs
                            </button>
                        </div>
                    </div>
                    <div class="table-responsive mpp-tree-body"/>
                </div>
                <button class="btn btn-primary mt-2 mpp-btn-to-suppliers">
                    Continue to Suppliers &amp; Production <i class="fa fa-arrow-right ml-1"></i>
                </button>
            </div>

            <!-- TAB 2: suppliers + production -->
            <div class="mpp-pane d-none" data-pane="2">
                <div class="msp-kpi-grid mpp-sup-cards mt-2"/>
                <div class="msp-table-card mt-2">
                    <div class="msp-table-search">
                        <div class="table-legend">
                            <span style="font-weight:700; color:#0f172a;">
                                <i class="fa fa-truck mr-1"></i> Suppliers (estimated USD)
                            </span>
                            <span class="text-muted" style="font-size:0.7rem;">Grouped by company - one draft RFQ per supplier. Totals are PO-value estimates (own last-buy USD x order); rolled goods value is shown per line</span>
                        </div>
                    </div>
                    <div class="mpp-sup-body"/>
                </div>
                <div class="msp-table-card mt-2">
                    <div class="msp-table-search">
                        <div class="table-legend">
                            <span style="font-weight:700; color:#0f172a;">
                                <i class="fa fa-cogs mr-1"></i> Production — Make &amp; Subcontract
                            </span>
                        </div>
                    </div>
                    <div class="mpp-prod-body"/>
                </div>
            </div>
        </div>
    </t>
</templates>
