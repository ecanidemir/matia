<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="MatiaProcurementPlan.Dashboard">
        <div class="o_matia_procurement_plan">
            <div class="mpp-header">
                <div>
                    <h2>Production Plan (TR)</h2>
                    <p>Admin only. Preview creates no records. Draft RFQs create no confirmation.</p>
                </div>
                <div>
                    <button class="btn btn-outline-light btn-sm mpp-btn-reload">Refresh</button>
                    <button class="btn btn-success btn-sm mpp-btn-excel">Excel (suppliers)</button>
                    <button class="btn btn-success btn-sm mpp-btn-excel-tree">Excel (tree)</button>
                </div>
            </div>

            <div class="mpp-step mpp-entry-wrap">
                <h4>1. Enter quantities (USA+TR stock shown)</h4>
                <div class="mpp-entry-toolbar mb-2">
                    <label>Fill to N:
                        <input type="number" min="0" value="50"
                            class="form-control form-control-sm mpp-fill-n d-inline-block"
                            style="width:90px;"/>
                    </label>
                    <button class="btn btn-secondary btn-sm mpp-btn-fill">Fill to N (avail → N)</button>
                    <button class="btn btn-outline-secondary btn-sm mpp-btn-clear">Clear</button>
                    <button class="btn btn-primary btn-sm mpp-btn-calc">Calculate tree + cost</button>
                </div>
                <table class="table table-sm table-striped">
                    <thead>
                        <tr>
                            <th>Code</th><th>Product</th><th>Kit</th>
                            <th>TR Available</th><th>USA Stock</th><th>Qty</th>
                        </tr>
                    </thead>
                    <tbody class="mpp-entry-body"/>
                </table>
            </div>

            <div class="mpp-step mpp-tree-wrap" style="display:none;">
                <h4>2. Tree + cost — <span class="mpp-tree-title"/></h4>
                <div class="mpp-tree-toolbar mb-2">
                    <input type="text" placeholder="Search code/name…"
                        class="form-control form-control-sm mpp-tree-search d-inline-block"
                        style="width:240px;"/>
                    <button class="btn btn-outline-secondary btn-sm mpp-btn-expand-all">Expand all</button>
                    <button class="btn btn-outline-secondary btn-sm mpp-btn-collapse-all">Collapse all</button>
                </div>
                <div class="mpp-tree-body"/>
            </div>

            <div class="mpp-step mpp-rfq-wrap" style="display:none;">
                <h4>3. Supplier preview + draft RFQs</h4>
                <div>Total: <strong class="mpp-total">0</strong></div>
                <div class="mt-2 mb-2">
                    <button class="btn btn-info btn-sm mpp-btn-rfq-preview">Preview Draft RFQs</button>
                    <button class="btn btn-success btn-sm mpp-btn-rfq-create">Create Draft RFQs</button>
                </div>
                <div class="mpp-rfq-preview mt-2 mb-2"/>
                <div class="mpp-tabs mt-2 mb-2"/>
                <table class="table table-sm table-striped">
                    <thead>
                        <tr>
                            <th>Code</th><th>Product</th><th>Level</th><th>Gross</th>
                            <th>TR Avail.</th><th>Net</th><th>Order</th>
                            <th>Supplier</th><th>Last Price</th><th>USD</th><th>Last Buy</th><th>Subtotal</th>
                        </tr>
                    </thead>
                    <tbody class="mpp-summary-body"/>
                </table>
                <div class="mpp-kits mt-2 mb-2"/>
                <div class="mpp-suppliers"/>
                <h5 class="mt-2">Created RFQs</h5>
                <div class="mpp-rfqs"/>
            </div>
        </div>
    </t>
</templates>
