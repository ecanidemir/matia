<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="MatiaProcurementPlan.Dashboard">
        <div class="o_matia_procurement_plan">
            <div class="mpp-header">
                <div>
                    <h2>Production Plan (TR)</h2>
                    <p>Admin only. RFQs/MOs are created as drafts; nothing is confirmed automatically.</p>
                </div>
                <div>
                    <button class="btn btn-outline-light btn-sm mpp-btn-reload">Refresh</button>
                    <button class="btn btn-success btn-sm mpp-btn-excel">Excel (suppliers)</button>
                    <button class="btn btn-success btn-sm mpp-btn-excel-tree">Excel (tree)</button>
                </div>
            </div>

            <ul class="nav nav-tabs mpp-nav-tabs mt-2">
                <li class="nav-item">
                    <a href="#" class="nav-link mpp-nav-tab active" data-tab="1">1. Enter Quantities</a>
                </li>
                <li class="nav-item">
                    <a href="#" class="nav-link mpp-nav-tab" data-tab="2">2. Tree + Cost</a>
                </li>
                <li class="nav-item">
                    <a href="#" class="nav-link mpp-nav-tab" data-tab="3">3. Suppliers &amp; Production</a>
                </li>
            </ul>

            <!-- TAB 1: grouped entry (same group look as Capacity Plan) -->
            <div class="mpp-pane" data-pane="1">
                <h4 class="mt-2">Enter quantities by group (TR+USA on-hand shown)</h4>
                <div class="mpp-entry-toolbar mb-2">
                    <span class="text-muted small">
                        <i class="fa fa-magic mr-1"></i>
                        Each group has its own auto-fill in its header
                        (target − on-hand per group).</span>
                    <button class="btn btn-outline-secondary btn-sm mpp-btn-clear ml-2">Clear</button>
                    <button class="btn btn-primary btn-sm mpp-btn-calc">Calculate tree + cost</button>
                </div>
                <div class="msp-table-card mt-2">
                    <div class="table-responsive">
                        <table class="msp-table">
                            <thead>
                                <tr>
                                    <th>Code</th><th>Product</th>
                                    <th>TR Avail.</th><th>USA Stock</th><th>Qty</th>
                                </tr>
                            </thead>
                            <tbody class="mpp-entry-body"/>
                        </table>
                    </div>
                </div>
            </div>

            <!-- TAB 2: capacity-identical tree -->
            <div class="mpp-pane d-none" data-pane="2">
                <div class="msp-table-card mt-2">
                    <div class="msp-table-search">
                        <div class="search-input-box">
                            <i class="fa fa-search"></i>
                            <input type="text" class="mpp-tree-search" placeholder="Search part code or name..."/>
                        </div>
                        <div class="table-legend">
                            <span><span class="dot-ok"></span> OK = covered by stock</span>
                            <span><span class="dot-need"></span> Red = net shortage after stock netting</span>
                            <span class="text-muted" style="font-size:0.7rem;"><i class="fa fa-sort mr-1"></i> Click column headers to sort</span>
                        </div>
                        <div class="msp-tool-buttons">
                            <button class="btn btn-outline-primary btn-sm msp-btn-expand-all">Expand All BOMs</button>
                            <button class="btn btn-outline-secondary btn-sm msp-btn-collapse-all">Collapse All BOMs</button>
                        </div>
                    </div>
                    <div class="table-responsive mpp-tree-body"/>
                </div>
                <button class="btn btn-primary mt-2 mpp-btn-to-suppliers">Continue to Suppliers &amp; Production →</button>
            </div>

            <!-- TAB 3: suppliers + production -->
            <div class="mpp-pane d-none" data-pane="3">
                <div class="msp-kpi-grid mpp-sup-cards mt-2"/>
                <h4 class="mt-2">Suppliers (estimated USD)</h4>
                <div class="mpp-sup-body"/>
                <h4 class="mt-3">Production — Make &amp; Subcontract</h4>
                <div class="mpp-prod-body"/>
            </div>
        </div>
    </t>
</templates>
