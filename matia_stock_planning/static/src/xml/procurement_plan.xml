<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="MatiaProcurementPlan.Dashboard">
        <div class="o_matia_procurement_plan">
            <div class="mpp-header">
                <div>
                    <h2>Procurement &amp; Production Plan — Preview (TR)</h2>
                    <p>Admin only. Creates no records (no PO/MO). Draft creation comes in a later phase.</p>
                </div>
                <div>
                    <button class="btn btn-outline-light btn-sm mpp-btn-reload">Refresh</button>
                    <button class="btn btn-success btn-sm mpp-btn-excel">Excel</button>
                </div>
            </div>

            <div class="mpp-step mpp-step-1">
                <h4>1. Step — Enter quantities (USA+TR stock shown)</h4>
                <table class="table table-sm table-striped">
                    <thead>
                        <tr>
                            <th>Code</th><th>Product</th><th>Kit</th>
                            <th>TR Available</th><th>USA Stock</th><th>Qty</th>
                        </tr>
                    </thead>
                    <tbody class="mpp-entry-body"/>
                </table>
                <button class="btn btn-primary mpp-btn-create">Confirm — Go to Net Requirement</button>
            </div>

            <div class="mpp-step mpp-step-2" style="display:none;">
                <h4>2. Step — Net requirement (TR stock netted)</h4>
                <button class="btn btn-primary btn-sm mpp-btn-explode">Calculate</button>
                <button class="btn btn-secondary btn-sm mpp-btn-suppliers">Go to Supplier Preview</button>
                <div class="mpp-tabs mt-2 mb-2"/>
                <table class="table table-sm table-striped">
                    <thead>
                        <tr>
                            <th>Code</th><th>Product</th><th>Level</th><th>Gross</th>
                            <th>TR Avail.</th><th>Net</th><th>Order</th>
                            <th>Supplier</th><th>Last Price</th><th>USD</th><th>Last Buy</th><th>Subtotal</th>
                        </tr>
                    </thead>
                    <tbody class="mpp-summary-body"/>
                </table>
            </div>

            <div class="mpp-step mpp-step-3" style="display:none;">
                <h4>3. Step — Supplier-based preview + cost</h4>
                <div>Total: <strong class="mpp-total">0</strong></div>
                <div class="mpp-kits mt-2 mb-2"/>
                <div class="mpp-suppliers"/>
            </div>
        </div>
    </t>
</templates>
