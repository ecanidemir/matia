<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Main Dashboard Template -->
    <t t-name="MatiaStockPlanning.Dashboard">
        <div class="o_matia_stock_planning">

            <!-- 1. Header Bar -->
            <div class="msp-header">
                <div class="msp-title-area">
                    <i class="fa fa-cubes"></i>
                    <div>
                        <h2 style="color: #ffffff !important; margin: 0; font-weight: 700;">TekRMD Device Capacity &amp; Stock Plan</h2>
                        <p style="color: #cbd5e1 !important; margin: 0; font-size: 0.85rem;">Net Stock &amp; Production Requirement Analysis Based on BOMs</p>
                    </div>
                </div>
                <div class="msp-actions">
                    <button class="btn btn-outline-light btn-sm msp-btn-refresh" title="Refresh Data">
                        <i class="fa fa-refresh mr-1"></i> Refresh
                    </button>
                    <button class="btn btn-success btn-sm msp-btn-excel" title="Export Current Visible Table to Excel">
                        <i class="fa fa-file-excel-o mr-1"></i> Export Excel
                    </button>
                </div>
            </div>

            <!-- 2. Controls &amp; Filters Card -->
            <div class="msp-controls-card">
                <!-- Left: Locations &amp; Companies Selection -->
                <div class="msp-filter-group">
                    <span class="msp-filter-label"><i class="fa fa-building-o mr-1"></i> Included Locations:</span>
                    <label class="form-check">
                        <input type="checkbox" class="form-check-input msp-check-tr" t-att-checked="widget.include_tr ? 'checked' : undefined"/>
                        <span class="badge-loc badge-tr"><i class="fa fa-map-marker mr-1"></i> TR (WHTR/Stock)</span>
                    </label>
                    <label class="form-check">
                        <input type="checkbox" class="form-check-input msp-check-usa" t-att-checked="widget.include_usa ? 'checked' : undefined"/>
                        <span class="badge-loc badge-usa"><i class="fa fa-map-marker mr-1"></i> USA (WHUS/Stock)</span>
                    </label>
                </div>

                <!-- Right: View &amp; Dynamic Column Tools -->
                <div class="msp-tool-buttons">
                    <button class="btn btn-outline-primary btn-sm msp-btn-expand-all" title="Expand all sub-assembly BOMs">
                        <i class="fa fa-plus-square-o mr-1"></i> Expand All BOMs
                    </button>
                    <button class="btn btn-outline-secondary btn-sm msp-btn-collapse-all" title="Collapse all sub-assembly BOMs">
                        <i class="fa fa-minus-square-o mr-1"></i> Collapse All BOMs
                    </button>

                    <button class="btn btn-secondary btn-sm msp-btn-toggle-bom" t-att-title="widget.show_bom_qty ? 'Hide Usage Qty' : 'Show Usage Qty'">
                        <i t-attf-class="fa #{widget.show_bom_qty ? 'fa-eye-slash' : 'fa-eye'} mr-1"></i>
                        <span t-if="widget.show_bom_qty">Hide Usage Qty</span>
                        <span t-else="">Show Usage Qty</span>
                    </button>

                    <!-- Inline target input -->
                    <t t-if="widget.dynamic_targets.length &lt; 3">
                        <div class="msp-add-col-inline" title="Enter device count and press Add">
                            <input type="number"
                                   class="form-control form-control-sm msp-col-target-input"
                                   placeholder="e.g. 100"
                                   min="1"
                                   style="width:90px; display:inline-block;"/>
                            <button class="btn btn-primary btn-sm msp-btn-add-col ml-1">
                                <i class="fa fa-plus-circle mr-1"></i> Add Column
                            </button>
                        </div>
                    </t>
                    <t t-else="">
                        <button class="btn btn-secondary btn-sm" disabled="disabled" title="Maximum 3 dynamic columns reached">
                            <i class="fa fa-plus-circle mr-1"></i> Add Column (Max 3)
                        </button>
                    </t>
                </div>
            </div>

            <!-- 3. Dynamic Chips Bar (If Any) -->
            <div class="msp-dynamic-chips-bar" t-if="widget.dynamic_targets.length > 0">
                <span class="chips-label"><i class="fa fa-columns mr-1"></i> Dynamic Columns:</span>
                <t t-foreach="widget.dynamic_targets" t-as="target">
                    <span class="target-chip">
                        <t t-esc="target"/> Devices Needed
                        <i class="fa fa-times-circle chip-remove" t-att-data-target="target" title="Remove this column"></i>
                    </span>
                </t>
                <small class="text-muted ml-2">(Max 3 columns, remaining: <t t-esc="3 - widget.dynamic_targets.length"/>)</small>
            </div>

            <!-- 4. KPI Summary Cards -->
            <div class="msp-kpi-grid">
                <!-- Overall Bottleneck -->
                <div class="msp-kpi-card kpi-overall">
                    <div class="kpi-info">
                        <div class="kpi-title">Producible TekRMD</div>
                        <div class="kpi-value text-primary"><t t-esc="widget.summary.overall_min_devices"/> Units</div>
                        <div class="kpi-sub" t-att-title="'Bottleneck Part: ' + widget.summary.overall_bottleneck">
                            Bottleneck: <t t-esc="widget.summary.overall_bottleneck"/>
                        </div>
                    </div>
                    <div class="kpi-icon text-primary"><i class="fa fa-cogs"></i></div>
                </div>

                <!-- Base Bottleneck -->
                <t t-set="base_grp" t-value="widget.get_group('base')"/>
                <div class="msp-kpi-card kpi-base">
                    <div class="kpi-info">
                        <div class="kpi-title">Base (Common Parts)</div>
                        <div class="kpi-value" style="color: #2563eb;">
                            <t t-if="base_grp"><t t-esc="base_grp.min_devices"/> Units</t>
                            <t t-else="">-</t>
                        </div>
                        <div class="kpi-sub" t-if="base_grp" t-att-title="'Bottleneck: ' + base_grp.bottleneck_product">
                            Bottleneck: <t t-esc="base_grp.bottleneck_product"/>
                        </div>
                    </div>
                    <div class="kpi-icon" style="color: #2563eb;"><i class="fa fa-cube"></i></div>
                </div>

                <!-- Outdoor Bottleneck -->
                <t t-set="outdoor_grp" t-value="widget.get_group('outdoor')"/>
                <div class="msp-kpi-card kpi-outdoor">
                    <div class="kpi-info">
                        <div class="kpi-title">Outdoor Parts</div>
                        <div class="kpi-value" style="color: #059669;">
                            <t t-if="outdoor_grp"><t t-esc="outdoor_grp.min_devices"/> Units</t>
                            <t t-else="">-</t>
                        </div>
                        <div class="kpi-sub" t-if="outdoor_grp" t-att-title="'Bottleneck: ' + outdoor_grp.bottleneck_product">
                            Bottleneck: <t t-esc="outdoor_grp.bottleneck_product"/>
                        </div>
                    </div>
                    <div class="kpi-icon" style="color: #059669;"><i class="fa fa-sun-o"></i></div>
                </div>

                <!-- Seat Bottleneck -->
                <t t-set="seat_grp" t-value="widget.get_group('seat')"/>
                <div class="msp-kpi-card kpi-seat">
                    <div class="kpi-info">
                        <div class="kpi-title">Seat Parts</div>
                        <div class="kpi-value" style="color: #7c3aed;">
                            <t t-if="seat_grp"><t t-esc="seat_grp.min_devices"/> Units</t>
                            <t t-else="">-</t>
                        </div>
                        <div class="kpi-sub" t-if="seat_grp" t-att-title="'Bottleneck: ' + seat_grp.bottleneck_product">
                            Bottleneck: <t t-esc="seat_grp.bottleneck_product"/>
                        </div>
                    </div>
                    <div class="kpi-icon" style="color: #7c3aed;"><i class="fa fa-wheelchair"></i></div>
                </div>

                <!-- Screws Bottleneck -->
                <t t-set="screws_grp" t-value="widget.get_group('screws')"/>
                <div class="msp-kpi-card kpi-screws">
                    <div class="kpi-info">
                        <div class="kpi-title">Common Screws</div>
                        <div class="kpi-value" style="color: #64748b;">
                            <t t-if="screws_grp"><t t-esc="screws_grp.min_devices"/> Units</t>
                            <t t-else="">-</t>
                        </div>
                        <div class="kpi-sub" t-if="screws_grp" t-att-title="'Bottleneck: ' + screws_grp.bottleneck_product">
                            Bottleneck: <t t-esc="screws_grp.bottleneck_product"/>
                        </div>
                    </div>
                    <div class="kpi-icon" style="color: #64748b;"><i class="fa fa-wrench"></i></div>
                </div>
            </div>

            <!-- 5. Main Table Card -->
            <div class="msp-table-card">
                <!-- Search &amp; Legend Bar -->
                <div class="msp-table-search">
                    <div class="search-input-box">
                        <i class="fa fa-search"></i>
                        <input type="text" class="msp-input-search" placeholder="Search part code or name..."/>
                    </div>
                    <div class="table-legend">
                        <span><span class="dot-ok"></span> OK = Stock Sufficient</span>
                        <span><span class="dot-need"></span> Red Number = Missing Parts for Target</span>
                        <span class="text-muted" style="font-size:0.7rem;"><i class="fa fa-sort mr-1"></i> Click column headers to sort</span>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="msp-table">
                        <thead>
                            <tr>
                                <th class="th-product msp-th-sortable" data-sort-col="name" t-attf-title="Sort by name #{widget.sort_col == 'name' ? (widget.sort_dir == 'asc' ? '↑' : '↓') : ''}">
                                    Part Name &amp; Code
                                    <i t-attf-class="fa ml-1 #{widget.sort_col == 'name' ? (widget.sort_dir == 'asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} msp-sort-icon"></i>
                                </th>
                                <th t-if="widget.show_bom_qty" class="th-bom-qty msp-th-sortable" data-sort-col="bom_qty">
                                    Usage Qty
                                    <i t-attf-class="fa ml-1 #{widget.sort_col == 'bom_qty' ? (widget.sort_dir == 'asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} msp-sort-icon"></i>
                                </th>
                                <th class="th-stock msp-th-sortable" data-sort-col="stock">
                                    Net Stock
                                    <i t-attf-class="fa ml-1 #{widget.sort_col == 'stock' ? (widget.sort_dir == 'asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} msp-sort-icon"></i>
                                </th>
                                <th class="th-ncr msp-th-sortable" data-sort-col="ncr">
                                    NCR Storage
                                    <i t-attf-class="fa ml-1 #{widget.sort_col == 'ncr' ? (widget.sort_dir == 'asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} msp-sort-icon"></i>
                                </th>
                                <th class="th-max-dev msp-th-sortable" data-sort-col="max_dev">
                                    Producible Devices
                                    <i t-attf-class="fa ml-1 #{widget.sort_col == 'max_dev' ? (widget.sort_dir == 'asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} msp-sort-icon"></i>
                                </th>
                                <th class="th-req-20 msp-th-sortable" data-sort-col="req_20">
                                    20 Devices Needed
                                    <i t-attf-class="fa ml-1 #{widget.sort_col == 'req_20' ? (widget.sort_dir == 'asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} msp-sort-icon"></i>
                                </th>
                                <t t-foreach="widget.dynamic_targets" t-as="target">
                                    <th class="th-dynamic msp-th-sortable" t-att-data-sort-col="'dyn_' + target">
                                        <div class="dyn-header-content">
                                            <span><t t-esc="target"/> Devices Needed</span>
                                            <i t-attf-class="fa #{widget.sort_col == 'dyn_' + target ? (widget.sort_dir == 'asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} msp-sort-icon"></i>
                                            <i class="fa fa-times btn-remove-dyn" t-att-data-target="target" title="Remove Column"></i>
                                        </div>
                                    </th>
                                </t>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- BOM Groups -->
                            <t t-foreach="widget.groups" t-as="group">
                                <!-- Group Header Row -->
                                <tr t-attf-class="group-row group-#{group.key}" t-att-data-group="group.key">
                                    <td t-att-colspan="widget.get_total_columns_count()">
                                        <div class="group-title-badge">
                                            <i t-if="group.key == 'base'" class="fa fa-cube mr-1 text-primary"></i>
                                            <i t-if="group.key == 'outdoor'" class="fa fa-sun-o mr-1 text-success"></i>
                                            <i t-if="group.key == 'seat'" class="fa fa-wheelchair mr-1 text-warning"></i>
                                            <i t-if="group.key == 'screws'" class="fa fa-wrench mr-1" style="color:#64748b;"></i>
                                            <span><t t-esc="group.title"/></span>
                                            <span class="group-count ml-2">(<t t-esc="group.items.length"/> Parts)</span>
                                            <span class="ml-auto text-muted" style="font-size: 0.75rem;">
                                                BOM: <t t-esc="group.bom_name"/>
                                            </span>
                                            <!-- Show / Hide toggle -->
                                            <button type="button"
                                                    t-attf-class="btn btn-sm msp-btn-toggle-group ml-2 #{widget.hidden_groups[group.key] ? 'msp-btn-group-show' : 'msp-btn-group-hide'}"
                                                    t-att-data-group-key="group.key"
                                                    t-att-title="widget.hidden_groups[group.key] ? 'Show this BOM group' : 'Hide this BOM group (also excluded from Excel export)'"
                                                    style="padding:1px 10px; font-size:0.75rem; font-weight:600;">
                                                <t t-if="widget.hidden_groups[group.key]">
                                                    <i class="fa fa-eye mr-1"></i>Show
                                                </t>
                                                <t t-else="">
                                                    <i class="fa fa-eye-slash mr-1"></i>Hide
                                                </t>
                                            </button>
                                        </div>
                                    </td>
                                </tr>

                                <!-- Product Rows -->
                                <t t-foreach="group.items" t-as="item">
                                    <tr class="item-row"
                                        t-att-data-product-name="item.display_name.toLowerCase()"
                                        t-att-data-group="group.key"
                                        t-att-style="widget.hidden_groups[group.key] ? 'display:none;' : ''">
                                        <!-- Part Code and Name with Sub-BOM toggle -->
                                        <td class="td-product">
                                            <t t-if="item.has_bom">
                                                <button type="button" class="btn btn-sm btn-link msp-btn-sub-bom p-0 mr-1 text-primary"
                                                        t-att-data-product-id="item.product_id"
                                                        t-att-data-product-name="item.display_name"
                                                        t-att-data-bom-qty="item.bom_qty"
                                                        title="Click to view sub-assembly BOM components">
                                                    <i class="fa fa-caret-right msp-bom-arrow"></i>
                                                </button>
                                            </t>
                                            <t t-else="">
                                                <span class="msp-bom-spacer mr-1"></span>
                                            </t>
                                            <span t-if="item.product_code" class="prod-code">[<t t-esc="item.product_code"/>]</span>
                                            <span class="prod-name" t-att-class="item.has_bom ? 'cursor-pointer msp-clickable-prod' : ''"
                                                  t-att-data-product-id="item.product_id"
                                                  t-att-data-bom-qty="item.bom_qty"
                                                  t-att-title="item.has_bom ? 'Click to show BOM components' : ''">
                                                <t t-esc="item.product_name"/>
                                            </span>
                                            <t t-if="item.has_bom">
                                                <span class="badge badge-light text-muted border ml-1" style="font-size:0.65rem;" title="Has Sub-Assembly BOM">BOM</span>
                                            </t>
                                        </td>

                                        <!-- Usage Qty (Toggleable) -->
                                        <td t-if="widget.show_bom_qty" class="td-bom-qty">
                                            <t t-esc="item.bom_qty"/> <small class="text-muted"><t t-esc="item.uom_name"/></small>
                                        </td>

                                        <!-- Net Stock -->
                                        <td class="td-stock">
                                            <t t-set="s_val" t-value="(item.stock_qty !== undefined &amp;&amp; item.stock_qty !== null &amp;&amp; item.stock_qty !== false) ? item.stock_qty : 0"/>
                                            <t t-if="s_val &lt;= 0">
                                                <span class="stock-zero">0</span>
                                            </t>
                                            <t t-else="">
                                                <t t-esc="s_val"/>
                                            </t>
                                        </td>

                                        <!-- NCR -->
                                        <td class="td-ncr">
                                            <t t-set="ncr_val" t-value="(item.ncr_qty !== undefined &amp;&amp; item.ncr_qty !== null &amp;&amp; item.ncr_qty !== false) ? item.ncr_qty : 0"/>
                                            <span t-attf-class="ncr-pill #{ncr_val &gt; 0 ? 'ncr-has-stock' : ''}" t-att-title="ncr_val &gt; 0 ? ncr_val + ' units available in NCR' : 'None in NCR'">
                                                <t t-esc="ncr_val"/>
                                            </span>
                                        </td>

                                        <!-- Producible Devices -->
                                        <td class="td-max-dev">
                                            <t t-if="item.max_devices &lt;= 0">
                                                <span class="dev-badge dev-critical">0</span>
                                            </t>
                                            <t t-else="">
                                                <span class="dev-normal"><t t-esc="item.max_devices"/></span>
                                            </t>
                                        </td>

                                        <!-- 20 Devices Needed -->
                                        <td class="td-req td-req-20">
                                            <t t-if="item.req_20_status == 'OK'">
                                                <span class="badge-req-ok"><i class="fa fa-check mr-1"></i> OK</span>
                                            </t>
                                            <t t-else="">
                                                <span class="badge-req-need"><t t-esc="item.req_20_val"/></span>
                                            </t>
                                        </td>

                                        <!-- Dynamic Target Columns -->
                                        <t t-foreach="widget.dynamic_targets" t-as="target">
                                            <t t-set="dyn_need" t-value="item.dynamic_needs[target.toString()]"/>
                                            <td class="td-req td-dynamic">
                                                <t t-if="dyn_need and dyn_need.status == 'OK'">
                                                    <span class="badge-req-ok"><i class="fa fa-check mr-1"></i> OK</span>
                                                </t>
                                                <t t-elif="dyn_need">
                                                    <span class="badge-req-need"><t t-esc="dyn_need.val"/></span>
                                                </t>
                                                <t t-else="">-</t>
                                            </td>
                                        </t>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </t>

    <!-- Sub-assembly BOM Component Rows Template -->
    <t t-name="MatiaStockPlanning.SubBomRows">
        <t t-foreach="data.items" t-as="item">
            <!-- data-group passed from JS so collapse-all and search can filter by group -->
            <tr class="item-row sub-bom-row"
                t-att-data-parent-id="parent_id"
                t-att-data-group="group_key"
                t-att-data-product-name="item.display_name.toLowerCase()">
                <!-- Part Code &amp; Name (Indented) -->
                <td class="td-product td-sub-product">
                    <span class="sub-bom-indent"></span>
                    <i class="fa fa-level-up fa-rotate-90 sub-tree-icon mr-2 text-primary"></i>
                    <span t-if="item.product_code" class="prod-code sub-prod-code">[<t t-esc="item.product_code"/>]</span>
                    <span class="prod-name"><t t-esc="item.product_name"/></span>
                </td>

                <!-- Usage Qty -->
                <td t-if="widget.show_bom_qty" class="td-bom-qty">
                    <span class="font-weight-bold"><t t-esc="item.bom_qty"/></span> <small class="text-muted"><t t-esc="item.uom_name"/></small>
                    <t t-if="item.parent_bom_qty &gt; 1">
                        <small class="text-muted d-block" style="font-size:0.7rem;">(<t t-esc="item.sub_bom_qty"/> × <t t-esc="item.parent_bom_qty"/>)</small>
                    </t>
                </td>

                <!-- Net Stock -->
                <td class="td-stock">
                    <t t-set="s_val" t-value="(item.stock_qty !== undefined &amp;&amp; item.stock_qty !== null &amp;&amp; item.stock_qty !== false) ? item.stock_qty : 0"/>
                    <t t-if="s_val &lt;= 0">
                        <span class="stock-zero">0</span>
                    </t>
                    <t t-else="">
                        <t t-esc="s_val"/>
                    </t>
                </td>

                <!-- NCR Storage -->
                <td class="td-ncr">
                    <t t-set="ncr_val" t-value="(item.ncr_qty !== undefined &amp;&amp; item.ncr_qty !== null &amp;&amp; item.ncr_qty !== false) ? item.ncr_qty : 0"/>
                    <span t-attf-class="ncr-pill #{ncr_val &gt; 0 ? 'ncr-has-stock' : ''}" t-att-title="ncr_val &gt; 0 ? ncr_val + ' units available in NCR' : 'None in NCR'">
                        <t t-esc="ncr_val"/>
                    </span>
                </td>

                <!-- Producible Devices -->
                <td class="td-max-dev">
                    <t t-if="item.max_devices &lt;= 0">
                        <span class="dev-badge dev-critical">0</span>
                    </t>
                    <t t-else="">
                        <span class="dev-normal"><t t-esc="item.max_devices"/></span>
                    </t>
                </td>

                <!-- 20 Devices Needed -->
                <td class="td-req td-req-20">
                    <t t-if="item.req_20_status == 'OK'">
                        <span class="badge-req-ok"><i class="fa fa-check mr-1"></i> OK</span>
                    </t>
                    <t t-else="">
                        <span class="badge-req-need"><t t-esc="item.req_20_val"/></span>
                    </t>
                </td>

                <!-- Dynamic Target Columns -->
                <t t-foreach="widget.dynamic_targets" t-as="target">
                    <t t-set="dyn_need" t-value="item.dynamic_needs[target.toString()]"/>
                    <td class="td-req td-dynamic">
                        <t t-if="dyn_need and dyn_need.status == 'OK'">
                            <span class="badge-req-ok"><i class="fa fa-check mr-1"></i> OK</span>
                        </t>
                        <t t-elif="dyn_need">
                            <span class="badge-req-need"><t t-esc="dyn_need.val"/></span>
                        </t>
                        <t t-else="">-</t>
                    </td>
                </t>
            </tr>
        </t>
    </t>

</templates>
